# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing & coverage
/coverage
/.nyc_output/
/test-results/
/playwright-report/
/blob-report/

# Temporary local testing scripts & scratchpad
/scratch/
/scripts/test-unit-storage-lifecycle.mjs
/scripts/audit-unit-storage.mjs
/scripts/seo-audit-crawler.mjs
/scripts/qa-runner-master.mjs
/scripts/verify-placeholders.mjs
/scripts/generate-csvs.mjs
/scripts/test-*.mjs
/scripts/*audit*.mjs
/scripts/*qa*.mjs
/scripts/*crawler*.mjs
!/scripts/check-home.mjs

# Temporary screenshots, test artifacts & cache
/screenshots/
/test-artifacts/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc & OS
.DS_Store
Thumbs.db
desktop.ini
*.pem

# debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files
.env
.env.*
!.env.example
!.env.sample

# Supabase temporary files
/supabase/.temp/
/supabase/migrations

# agents
.agents

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# root documentation & agent scratch
/*.md
!/README.md
!/readme.md
!/LICENSE.md
!/PANDUAN_ADMIN_TITIKHUNI.md
out.html

# project documentation exceptions (allow docs and SEO deliverables)
!/docs/
!/docs/**

# Temporary test files & artifacts inside docs
/docs/test/
/docs/qa-reports/**/screenshots/
/docs/qa-reports/**/logs/
